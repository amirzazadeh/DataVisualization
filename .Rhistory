colnames(V) <- c("link","province","region","male_pop_15_49","urban_area","urban_prop","n_univ_college","n_university","n_college","n_industry_zone","literacy_rate","pop_density","poverty_rate","tourism_rev_bil_vnd")
# Load necessary libraries
library(ggplot2)
library(raster) # For downloading GADM maps if spatial joining is needed
# 1. (Optional) Download Vietnam Map Data from GADM
# This downloads the Level 1 (Province) administrative boundaries
# vietnam_map <- getData('GADM', country='VNM', level=1)
# 2. Create the Visualization
# We use 'dataset V' with variables 'poverty_rate' and 'literacy_rate'
plot <- ggplot(V, aes(x = poverty_rate, y = literacy_rate)) +
# Add points (Scatterplot)
geom_point(alpha = 0.6, color = "black") +
# Add Linear Regression Line (Accuracy & Appropriateness)
geom_smooth(method = "lm", se = FALSE, color = "red", size = 1) +
# Set limits to the range of data (Accuracy)
scale_x_continuous(limits = range(V$poverty_rate, na.rm = TRUE)) +
scale_y_continuous(limits = range(V$literacy_rate, na.rm = TRUE)) +
# Clear Labels and Titles (Clarity)
labs(
title = "Relationship Between Province Poverty and Literacy Rates in Vietnam",
x = "Poverty Rate (%)",
y = "Literacy Rate (%)",
caption = "Source: Dataset V"
) +
# Simplicity: Remove grids, background, and unnecessary lines
theme_classic() +
theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
text = element_text(family = "sans", size = 12) # Consistent formatting
)
