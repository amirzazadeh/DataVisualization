device = "jpeg",
dpi = 300,
width = 7,
height = 5,
units = "in"
)
# Load necessary libraries
library(ggplot2)
# Assuming 'V' is your dataset
# variable: poverty_rate
# category: province (or similar grouping variable)
# 1. Create the visualization
p <- ggplot(V, aes(x = province, y = poverty_rate)) +
# Use a clean boxplot without outliers if they clutter,
# but here we keep them for accuracy
geom_boxplot(fill = "grey90", color = "black", outlier.size = 1) +
# Clarity: Clear labels and titles
labs(
title = "Distribution of Poverty Rates by Province in Vietnam",
x = "Province",
y = "Poverty Rate (%)"
) +
# Accuracy: Set limits to the range of data (adjusting to your specific min/max)
scale_y_continuous(limits = c(min(V$poverty_rate), max(V$poverty_rate))) +
# Simplicity: Remove grids, background colors, and unnecessary lines
theme_minimal() +
theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
axis.line = element_line(color = "black"),
text = element_text(family = "sans", size = 12),
axis.text.x = element_text(angle = 45, hjust = 1) # Rotate for readability
)
# 2. Display the plot
print(p)
# 3. Exporting Publication-Ready Figure
# Saving as JPG, 300 DPI
ggsave(
filename = "Vietnam_Poverty_Boxplot.jpg",
plot = p,
device = "jpeg",
dpi = 300,
width = 10,
height = 7,
units = "in"
)
# Load required library
library(ggplot2)
# Inspect data range (for accurate axis limits)
range_poverty  <- range(V$poverty_rate, na.rm = TRUE)
range_literacy <- range(V$literacy_rate, na.rm = TRUE)
# Create scatterplot
p <- ggplot(V, aes(x = poverty_rate, y = literacy_rate)) +
# Simple points (no unnecessary styling)
geom_point(size = 2) +
# Clear labels and title
labs(
title = "Relationship Between Poverty Rate and Literacy Rate in Vietnam",
x = "Poverty Rate (%)",
y = "Literacy Rate (%)"
) +
# Accuracy: set limits exactly to data range
scale_x_continuous(limits = range_poverty) +
scale_y_continuous(limits = range_literacy) +
# Simplicity: remove gridlines and unnecessary elements
theme_classic(base_size = 12) +
theme(
plot.title = element_text(hjust = 0.5),  # center title
axis.title = element_text(size = 12),
axis.text = element_text(size = 10)
)
# Show plot
print(p)
print(p)
