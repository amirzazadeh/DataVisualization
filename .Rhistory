library(dagitty)
# install if needed
# install.packages("dagitty")
library(dagitty)
# Define DAG
dag <- dagitty('
dag {
# Exposure and outcome
usborn [exposure]
hpv    [outcome]
# Demographics
age
gender
hispanic
# Mediators
edu_grp
married_flag
# Causal structure
# Age effects
age -> edu_grp
age -> married_flag
age -> hpv
# Sex effect
gender -> hpv
# Ethnicity effects
hispanic -> edu_grp
hispanic -> hpv
# Nativity effects
usborn -> edu_grp
usborn -> married_flag
usborn -> hpv
# Mediation pathway
edu_grp -> married_flag
edu_grp -> hpv
married_flag -> hpv
}
')
plot(dag)
# Define DAG
dag <- dagitty('
dag {
# Exposure and outcome
usborn [exposure]
hpv    [outcome]
# Demographics
age
gender
hispanic
# Mediators
edu_grp
married_flag
# Causal structure
# Age effects
age -> edu_grp
age -> married_flag
age -> hpv
# Sex effect
gender -> hpv
# Ethnicity effects
hispanic -> edu_grp
hispanic -> hpv
# Nativity effects
usborn -> edu_grp
usborn -> married_flag
usborn -> hpv
# Mediation pathway
edu_grp -> married_flag
edu_grp -> hpv
married_flag -> hpv
}
')
# install.packages("dagitty")   # run if needed
# install.packages("ggdag")     # optional, for nicer plotting
library(dagitty)
library(ggdag)    # optional, only for plotting if installed
dag <- dagitty('
dag {
usborn [exposure]
hpv    [outcome]
age
gender
hispanic
edu_grp
married_flag
age -> edu_grp
age -> married_flag
age -> hpv
gender -> hpv
hispanic -> edu_grp
hispanic -> hpv
usborn -> edu_grp
usborn -> married_flag
usborn -> hpv
edu_grp -> married_flag
edu_grp -> hpv
married_flag -> hpv
}
')
# Print DAGitty summary
print(dag)
# Show minimal sufficient adjustment sets for total effect (usborn -> hpv)
adjustmentSets(dag)
# Plot (basic)
plot(dag)
# Optional: prettier plot with ggdag
if (requireNamespace("ggdag", quietly = TRUE)) {
library(ggdag)
ggdag(dag, text = TRUE, use_labels = "name") + ggplot2::theme_minimal()
}
library(readxl)
V <- read_excel("Documents/GitHub/DataVisualization/data.xlsx")
# Load necessary libraries
library(ggplot2)
library(raster) # For downloading GADM maps if spatial joining is needed
# 1. (Optional) Download Vietnam Map Data from GADM
# This downloads the Level 1 (Province) administrative boundaries
vietnam_map <- getData('GADM', country='VNM', level=1)
# Load necessary libraries
library(ggplot2)
library(raster) # For downloading GADM maps if spatial joining is needed
# 1. (Optional) Download Vietnam Map Data from GADM
# This downloads the Level 1 (Province) administrative boundaries
# vietnam_map <- getData('GADM', country='VNM', level=1)
# 2. Create the Visualization
# We use 'dataset V' with variables 'poverty_rate' and 'literacy_rate'
plot <- ggplot(V, aes(x = poverty_rate, y = literacy_rate)) +
# Add points (Scatterplot)
geom_point(alpha = 0.6, color = "black") +
# Add Linear Regression Line (Accuracy & Appropriateness)
geom_smooth(method = "lm", se = FALSE, color = "red", size = 1) +
# Set limits to the range of data (Accuracy)
scale_x_continuous(limits = range(V$poverty_rate, na.rm = TRUE)) +
scale_y_continuous(limits = range(V$literacy_rate, na.rm = TRUE)) +
# Clear Labels and Titles (Clarity)
labs(
title = "Relationship Between Province Poverty and Literacy Rates in Vietnam",
x = "Poverty Rate (%)",
y = "Literacy Rate (%)",
caption = "Source: Dataset V"
) +
# Simplicity: Remove grids, background, and unnecessary lines
theme_classic() +
theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
text = element_text(family = "sans", size = 12) # Consistent formatting
)
# 3. Display the plot
print(plot)
View(V)
