text = element_text(family = "sans"), # Consistent font style
plot.title = element_text(face = "bold", size = 14),
plot.subtitle = element_text(size = 11, color = "grey30")
)
# --- 4. Accuracy: Ensure proper scales ---
# Setting limits to 0-100% as these are rates
p <- p + coord_cartesian(ylim = c(0, 100), xlim = c(0, 100))
# Display the plot
print(p)
# --- 5. Exporting Publication-Ready Figure ---
# Save as JPG with 300 DPI
ggsave(
filename = "Vietnam_Poverty_Literacy_Relationship.jpg",
plot = p,
device = "jpeg",
dpi = 300,
width = 8,
height = 6,
units = "in"
)
p
# Load necessary libraries
library(ggplot2)
# --- 1. Create the Visualization ---
# Using 'dataset' (V), mapping poverty_rate to X and literacy_rate to Y
p <- ggplot(V, aes(x = poverty_rate, y = literacy_rate)) +
# Add points with slight transparency to handle potential overlap
geom_point(alpha = 0.6, color = "#2c3e50") +
# Add a linear regression line (lm) without the confidence interval (se=FALSE)
# to keep the chart simple and focused on the main trend
geom_smooth(method = "lm", color = "#e74c3c", se = FALSE, size = 1) +
# --- 2. Clarity: Clear Labels and Titles ---
labs(
title = "Relationship Between Province Poverty and Literacy Rates in Vietnam",
subtitle = "Analysis of provincial-level correlation",
x = "Poverty Rate (%)",
y = "Literacy Rate (%)",
caption = "Data Source: Vietnam Provincial Dataset"
) +
# --- 3. Simplicity: Minimalist Theme ---
theme_minimal() +
theme(
panel.grid.major = element_blank(), # Remove major grids
panel.grid.minor = element_blank(), # Remove minor grids
axis.line = element_line(color = "black"), # Keep axis lines for accuracy
text = element_text(family = "sans"), # Consistent font style
plot.title = element_text(face = "bold", size = 14),
plot.subtitle = element_text(size = 11, color = "grey30")
)
p
# Load necessary library
library(ggplot2)
# 1. Create the Scatterplot with Regression Line
# Data: V | X-axis: poverty_rate | Y-axis: literacy_rate
plot <- ggplot(V, aes(x = poverty_rate, y = literacy_rate)) +
# Add points (Scatterplot)
geom_point(color = "black", alpha = 0.6) +
# Add linear regression line (no shaded confidence interval for simplicity)
geom_smooth(method = "lm", color = "red", se = FALSE) +
# Set limits to the range of data for accuracy
scale_x_continuous(limits = range(V$poverty_rate, na.rm = TRUE)) +
scale_y_continuous(limits = range(V$literacy_rate, na.rm = TRUE)) +
# Add clear labels and title
labs(
title = "Relationship Between Poverty and Literacy Rates in Vietnam",
x = "Province Poverty Rate (%)",
y = "Literacy Rate (%)"
) +
# Apply a minimalist theme (Simplicity: no grids, white background)
theme_classic() +
theme(
text = element_text(family = "sans", size = 12), # Consistent font
plot.title = element_text(face = "bold", hjust = 0.5)
)
# 2. Show the plot in the console
print(plot)
# 3. Export as a publication-ready JPG (300 DPI)
ggsave(
filename = "Vietnam_Poverty_Literacy_Relationship.jpg",
plot = plot,
device = "jpeg",
dpi = 300,
width = 7,
height = 5,
units = "in"
)
# Load necessary libraries
library(geodata)   # To download GADM maps
library(sf)        # For handling spatial data
library(ggplot2)   # For visualization
library(dplyr)     # For data manipulation
# 1. Download Vietnam Provincial Map (Level 1) from GADM
# 'VNM' is the ISO code for Vietnam; level = 1 provides provinces
vietnam_map <- gadm(country = "VNM", level = 1, path = tempdir(), version = "latest")
vietnam_sf <- st_as_sf(vietnam_map) # Convert to sf object for ggplot2
# 2. Join the map with your dataset 'V'
# Ensure 'V' has a column that matches the province names in 'vietnam_sf$NAME_1'
map_data <- vietnam_sf %>%
left_join(V, by = c("VARNAME_1" = "province")) # Replace 'province_name' with your actual column name
# 3. Create the Map
p <- ggplot(data = map_data) +
# Accuracy: Represent data truthfully with a continuous scale
geom_sf(aes(fill = poverty_rate), color = "white", size = 0.1) +
# Clarity: Use a clear, perceptible color scale and labels
scale_fill_viridis_c(
name = "Poverty Rate (%)",
option = "plasma",
na.value = "grey90",
# Accuracy: Set limits to the range of data
limits = range(V$poverty_rate, na.rm = TRUE)
) +
# Simplicity: Remove background grids, axes, and unnecessary lines
theme_void() +
# Clarity: Add descriptive title and consistent formatting
labs(
title = "Poverty Rate by Province in Vietnam",
subtitle = "Analysis based on dataset V",
caption = "Source: GADM.org"
) +
theme(
plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
plot.subtitle = element_text(size = 11, hjust = 0.5),
legend.position = "right",
text = element_text(family = "sans") # Consistent font style
)
# 4. Show and Export Publication-Ready Figure
# Save as JPG with 300 DPI as requested
print(p)
ggsave("Vietnam_Poverty_Map.jpg", plot = p, width = 7, height = 10, dpi = 300)
# ============================================================
# Province-Level Poverty Rate Map for Vietnam
# Dataset: V | Variable: poverty_rate
# ============================================================
# --- 1. Load Required Libraries ---
library(geodata)      # Download GADM shapefiles
library(sf)           # Spatial data handling
library(ggplot2)      # Visualization
library(dplyr)        # Data manipulation
library(scales)       # Scale formatting
# --- 2. Download Vietnam Province-Level Map (GADM Level 1) ---
# Downloads shapefile to a temp directory; level=1 = provinces
vnm_map <- geodata::gadm(country = "VNM", level = 1, path = tempdir())
vnm_sf  <- sf::st_as_sf(vnm_map)   # Convert to sf object
# Preview province names (use these to match your dataset)
# head(vnm_sf$NAME_1)
# --- 3. Prepare Your Dataset ---
# Your dataset 'V' must have:
#   - A province name column matching GADM NAME_1 values
#   - A numeric 'poverty_rate' column (e.g., values 0–100)
#
# Example structure (replace with your actual data):
# V <- data.frame(
#   province   = c("Ha Noi", "Ho Chi Minh City", ...),
#   poverty_rate = c(1.5, 0.8, ...)
# )
# --- 4. Join Spatial Data with Dataset ---
vnm_data <- vnm_sf %>%
left_join(V, by = c("VARNAME_1" = "province"))   # Adjust join key if needed
# --- 5. Define Map Limits from Actual Data Range ---
rate_min <- min(V$poverty_rate, na.rm = TRUE)
rate_max <- max(V$poverty_rate, na.rm = TRUE)
# --- 6. Create the Map ---
map_plot <- ggplot(data = vnm_data) +
# Choropleth fill by poverty rate
geom_sf(aes(fill = poverty_rate),
color = "white",      # Province borders in white
linewidth = 0.3) +
# Sequential color scale anchored to actual data range
scale_fill_gradientn(
colors   = c("#fef0d9", "#fdcc8a", "#fc8d59", "#e34a33", "#b30000"),
limits   = c(rate_min, rate_max),
name     = "Poverty Rate (%)",
na.value = "grey85",
guide    = guide_colorbar(
barwidth  = 0.8,
barheight = 10,
title.position = "top"
)
) +
# Labels & title
labs(
title    = "Province-Level Poverty Rate in Vietnam",
subtitle = "Source: Dataset V  |  Variable: poverty_rate",
caption  = "Map data: GADM (gadm.org)"
) +
# Clean, publication-ready theme
theme_void(base_size = 13) +
theme(
plot.title    = element_text(face = "bold", hjust = 0.5, size = 15,
margin = margin(b = 4)),
plot.subtitle = element_text(hjust = 0.5, size = 10, color = "grey40",
margin = margin(b = 6)),
plot.caption  = element_text(hjust = 0.5, size = 8,  color = "grey55"),
legend.position       = "right",
legend.title          = element_text(face = "bold", size = 10),
legend.text           = element_text(size = 9),
plot.background       = element_rect(fill = "white", color = NA),
plot.margin           = margin(10, 10, 10, 10)
)
# --- 7. Display the Map ---
print(map_plot)
# --- 8. Export as Publication-Ready JPEG (300 DPI) ---
ggsave(
filename = "vietnam_poverty_rate_map.jpg",
plot     = map_plot,
width    = 6,
height   = 9,
dpi      = 300,
units    = "in"
)
